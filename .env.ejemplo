# Copia este archivo con el nombre .env y cambia los valores que necesites.
# Si no creas .env, AgroPOS funciona con estos mismos valores por defecto.

# Identificador de esta caja (usa uno distinto en cada computador)
CAJA_ID=CAJA-01

# Puertos donde se abre la página
PUERTO_CAJA=3000
PUERTO_NUBE=4000

# Dirección del servidor en la nube (npm run start:nube)
NUBE_URL=http://localhost:4000

# Clave compartida entre las cajas y la nube (debe ser igual en todos)
CLAVE_SYNC=cambiar-esta-clave

# Cada cuántos segundos se intenta subir ventas pendientes
INTERVALO_SYNC_SEG=15
